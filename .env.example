# Photo Group Portal Environment Configuration Template

# Core Application Settings
APP_NAME="Photo Group Portal"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"
DEBUG=True

# API Configuration
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration
# Primary: PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photo_group_portal"
# Fallback option for quick local testing without Postgres setup:
# DATABASE_URL="sqlite:///./photo_group_portal.db"

# Storage Settings (Foundation for future days)
STORAGE_DIR="./storage"

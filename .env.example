# Frontend API URL Configuration
VITE_API_URL="http://localhost:8000"

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photo_group_portal"

# Storage Settings
STORAGE_DIR="./storage"

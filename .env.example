# Photo Group Portal Environment Configuration Template

# Core Application Settings
APP_NAME="Photo Group Portal"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"
DEBUG=True
LOG_LEVEL="INFO"

# API Configuration
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Security & Authentication Settings
SECRET_KEY="secret-key-change-in-production-environments-123456789"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days in minutes

# Frontend API URL Configuration
VITE_API_URL="http://localhost:8000"

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photo_group_portal"

# Storage Settings
STORAGE_DIR="./storage"
